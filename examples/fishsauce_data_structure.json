{
  "_status": "EXTENDS the single-table data_structure.schema.json. This workbook has SEVERAL analysis blocks across SHEETS; the current run_agent.py loader reads one sheet only. Two small patches are needed to run this through the agent: (1) a `sheet` field + sheet-aware loader, (2) rules for within-subject paired ratings and an implicit (IAT) measure.",
  "file": { "path": "Word_association.xlsx", "format": "xlsx", "header": true },
  "tables": [
    {
      "name": "word_topic",
      "sheet": "Binary (topic)",
      "layout": "consumer_by_term_binary",
      "id_columns": ["Mã đăng nhập"],
      "group_columns": ["region", "gender", "age", "user", "frequency"],
      "blocks": [
        { "name": "WA_topic", "lens": "cata", "n_terms": 10, "note": "binary 0/1 association at topic level" }
      ]
    },
    {
      "name": "word_element",
      "sheet": "Binary (element)",
      "layout": "consumer_by_term_binary",
      "id_columns": ["Mã đăng nhập"],
      "group_columns": ["region", "gender", "age", "user", "frequency"],
      "blocks": [
        { "name": "WA_element", "lens": "cata", "n_terms": 22, "note": "binary 0/1 association at element level" }
      ]
    },
    {
      "name": "iat",
      "sheet": "IAT",
      "layout": "consumer_by_attribute_paired",
      "id_columns": ["ID"],
      "group_columns": ["region", "gender", "age", "user", "frequency", "Version"],
      "blocks": [
        { "name": "explicit_TT", "lens": "hedonic", "columns": ["liking_TT","tasty_TT","packaging_TT","protein_TT","healthy_TT","price_TT","ingre_TT","familar_TT","popular_TT"], "note": "explicit ratings of the traditional product (1-9)" },
        { "name": "explicit_CN", "lens": "hedonic", "columns": ["liking_CN","tasty_CN","packaging_CN","protein_CN","healthy_CN","price_CN","ingre_CN","familar_CN","popular_CN"], "note": "explicit ratings of the industrial product (1-9)" },
        { "name": "implicit", "lens": "attitude", "columns": ["d_score","B4_RT","B7_RT"], "note": "IAT d_score (sign needs design doc) + reaction times (VN number format)" }
      ]
    }
  ],
  "group_recodes": {
    "Region3": { "from": "region", "map": { "north": "Bắc", "central": "Trung", "south": "Nam" }, "drop": ["Không rõ", "Unknown"] },
    "User2": { "from": "user", "map": { "TT": "Truyền thống", "CN": "Công nghiệp" } }
  }
}
